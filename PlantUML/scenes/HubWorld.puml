@startuml
enum GameState {
    Hub,
    Battle,
    Info,
    Exit,
}
class HubWorld <<partial>> {
    + EnemyScene : PackedScene
    + EnemyContainer : Node2D
    + SpawnMin : Vector2
    + SpawnMax : Vector2
    - player : Player
    - battleUI : BattleUI
    - infoPane : InfoPane
    - exitPanel : ExitPane
    - State : GameState
    - <<const>> ENEMY_COUNT : int = 5
    - rng : RandomNumberGenerator
    - opponent : Character = null
    - <<const>> NUMBER_OF_MOVES : int = 5
    + <<override>> _Ready() : void
    + PlayerAttack(word:string) : void
    - TriggerEnemyAttack() : void
    + <<override>> _Notification(what:int) : void
    - SaveAndQuit() : void
    - SpawnEnemies() : void
    - StartBattle(enemy:Character) : void
    - RefreshInfoPane() : void
    - OpenInfoPane() : void
    + <<override>> _Input(e:InputEvent) : void
    - ChangeState(state:GameState) : void
    - Save(path:string) : void
    - Load(path:string) : void
    + RespawnEnemies() : void
    + Save() : Dictionary<string, object>
    + Load(dict:Dictionary<string, JsonElement>) : void
}
Node2D <|-- HubWorld
ISaveable <|-- HubWorld
@enduml
